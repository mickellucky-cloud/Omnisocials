# ==============================================================================
# OmniSocial Studio - Real API Integration Environment Variables
# ==============================================================================
# You can supply credentials here or configure them directly via the in-app
# "Social Accounts" credentials manager.

# 1. Google Gemini AI (for cross-network content adaptation & sentiment analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Ayrshare Unified Social API (Single key for X, LinkedIn, FB, IG, TikTok, YouTube)
# Get your API key at: https://app.ayrshare.com/
AYRSHARE_API_KEY=

# 3. Telegram Bot API (Direct live delivery without app approvals)
# 1) Message @BotFather on Telegram to create a bot and get your token
# 2) Add the bot as Admin to your channel or group
# 3) Enter the bot token and channel username (e.g. @mychannel) or numeric chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Twitter / X API v2 (Direct)
# Get keys at: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# 5. LinkedIn REST API (Direct)
# Create app at: https://www.linkedin.com/developers/
# Required scopes: w_member_social, r_liteprofile (or w_organization_social)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_URN_ID

# 6. Meta / Facebook & Instagram Graph API (Direct)
# Get Page Access Token at: https://developers.facebook.com/tools/explorer/
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
